# task_manager  →  pick_place_server        액션 /manipulation/place_carrier
#
# 기능: 주어진 점 위에서 흡착을 풀어 내려놓는다. 그게 전부다.
#       "이 포트에 이 종류를 놔도 되나"(매거진→패키징, 스택→테스트) 와
#       "들고 있는 게 명령받은 그거 맞나" 는 goal 을 보내기 전에
#       task_manager 가 끝낸다. 팔은 종류도 ID 도 모른다.
#
# pick_place_server 파라미터 (goal 에 없다): release_height_m · approach_dist_m
#
# NOT_GRIPPED: 도착했는데 이미 gripped=false — 이송 중 놓쳤다.
#              task_manager 는 이걸 PLACE 가 아니라 TRANSIT 실패로 기록한다.

# ── goal ──
geometry_msgs/PoseStamped slot_pose     # 슬롯 바닥 중심. frame_id = base_link
---
# ── result ──
uint8 NONE=0
uint8 NO_IK=1
uint8 COLLISION=2
uint8 PORT_OCCUPIED=3           # 내려놓을 자리에 이미 뭔가 있다
uint8 NOT_GRIPPED=4
uint8 CANCELED=5

bool  success
uint8 fail_reason
---
# ── feedback ──
uint8 APPROACH=0
uint8 DESCEND=1
uint8 RELEASE=2
uint8 RETRACT=3

uint8 phase

# ══════════════════════════════════════════════════════════════════════
#  보내는 노드 : web backend (cobot3_web / task_dispatcher)
#  받는 노드   : cobot3_orchestrator / task_manager
#  종류        : 액션  /{robot}/orchestrator/execute_task
#  역할        : "이 선반에 가서 캐리어 **하나** 를 처리해라".
#                판독·파지·이송·배치는 전부 로봇이 알아서 한다.
#  전달 내용   : goal: task_id · kind · target_ref · resume_progress
#                result: success · run_id · more_at_target
#                feedback: stage · progress · run_id · carrier_id
# ══════════════════════════════════════════════════════════════════════

# ★ 이 액션이 순찰을 없애는 것이 아니다 — 순찰의 '어느 선반' 만 가져간다.
#
#   로봇은 지금처럼 스스로 일을 찾는다. 선반 앞에 서서 carrier_detected 를 받고,
#   HOLD 하고, CarrierScan 으로 QR 을 읽고, 파지 자세를 손목캠으로 보정하고,
#   이송하고 배치한다. 그 트리(task_manager 의 mission 가지)는 그대로다.
#   웹이 가져가는 것은 **"다음에 어느 선반으로 갈까"** 하나뿐이다.
#
#   ★ 선반을 독점시키려는 것이 **아니다.** 두 로봇이 같은 선반에 붙어
#     매거진을 나눠 빼는 것이 정상 운용이고, DB 에도 선반 lock 이 없다
#     (sql/003_task.sql 주석 참고).
#
#   그럼에도 큐가 필요한 이유는 셋이다:
#     1. 회수(RECOVER)가 스캔을 선점해야 한다. 스테이션 capacity 가 1이라
#        산출물을 안 치우면 다음 place 가 PORT_OCCUPIED 로 막힌다.
#        순찰만으로는 "지금 저기부터 가라" 를 표현할 방법이 없다.
#     2. 두 로봇의 부하를 나눈다(자동 분배). 순찰로가 하나면 둘이 같은
#        순서로 돌아 앞뒤로 붙어 다닌다.
#     3. 웹이 재시작해도 배정이 남는다 — 그래서 메모리가 아니라 표다(§10-1).
#
#   1대로 돌릴 때는 웹이 선반 목록을 순서대로 큐에 넣어 두면 그게 순찰이다.
#
#   ⚠️ 선반을 안 잠그므로 **두 로봇이 같은 캐리어를 노릴 수 있다.**
#      goal 은 선반까지만 가리키고 그 선반에 무엇이 있는지는 scan 해야 알기
#      때문에 배정 시점에 막을 수 없다. 실제로 부딪히면 배타를 선반이 아니라
#      캐리어(qr_payload) 수준에 걸어야 한다 — feedback.carrier_id 로 이미
#      올라오므로 웹이 "그 payload 로 다른 로봇이 RUNNING 중" 을 감지할 수 있다.
#
# ★ task 1건 = 캐리어 1개다. 그리고 **복귀까지 끝나야 1건이 끝난다.**
#
#     scan → pick → nav(스테이션) → place → return(선반) → 여기서 작업 종료
#
#   return 을 작업 밖으로 빼면 안 되는 이유가 둘이다:
#
#     1. more_at_target 을 판단할 수 있는 자리가 선반뿐이다. place 를 끝낸
#        순간 로봇은 스테이션에 서 있어 선반에 뭐가 남았는지 알 수 없다.
#        선반으로 돌아와 carrier_detected 를 다시 봐야 답이 나온다.
#     2. 다음 작업이 같은 선반이면 이미 그 앞에 서 있어 이동 비용이 0이다.
#        복귀를 빼면 매번 스테이션에서 선반까지 다시 가야 한다.
#
#   ★ 그래서 return 의 목적지는 PATROL_ROUTE[0] 이 아니라 **goal 의 target_ref**
#     (shelves.yaml 의 approach)다. 지금 task_manager 의 RETURN 은 순찰 시작점으로
#     가는데, 이 액션을 받는 구조에서는 그 좌표를 goal 에서 가져와야 한다.
#
#   선반에 매거진이 3개면 작업도 3건이다. 배정 시점에 몇 개가 있는지 모르므로,
#   복귀한 로봇이 result.more_at_target 으로 "아직 더 있다" 를 알려주고 웹이
#   곧바로 후속 작업을 건다. 로봇은 선반 앞에 선 채로 다음 goal 을 받아
#   이어서 돈다 — 사람이 매번 다시 배정하지 않는다.
#
#   비어 있으면 NO_CARRIER 로 돌아오고, 그건 실패가 아니다
#   (docs/DB구성.md §8-4 — found=false 는 에러가 아니다).
#
#   한 작업이 캐리어 여러 개를 처리하게 두지 않은 이유: run_id 는 미션 1회를
#   묶는 끈이라(§4-1) 작업 하나에 run_id 가 여러 개가 되고, 그러면 task.run_id
#   단일 칸이 깨진다. 표를 늘리지 않으려면 작업의 단위를 미션에 맞추는 편이 곧다.
#
# ★ 액션인 이유는 NavigateTo 와 같다 — 취소가 필요해서다.
#   화면의 SKIP(현재 작업 건너뛰기)과 STOP 이 cancel_goal() 로 내려간다.
#   서비스에는 취소가 없고, 토픽에는 결과가 없다.
#
# ★ run_id 가 goal 에 없고 feedback/result 에 있는 이유:
#   미션 1회를 여는 것은 QR 판독 성공이다(§4-6). 웹이 작업을 배정하는 시점에는
#   그 선반에 무엇이 있는지 모르므로 run_id 를 만들 수 없다. ScanLeaf 가 성공한
#   순간 task_manager 가 uuid4() 를 발행하고, 그 값이 feedback 으로 웹에 올라와
#   task.run_id 에 찍힌다. 이 칸 하나가 "배정" 과 "이력" 두 세계를 잇는다(§10-5).
#
# ★ task_manager 쪽 변경 (이 액션을 받으려면):
#   지금은 START_DETECTED_FOR_TEST(:216) 로 자기가 미션을 시작한다. 외부 지시를
#   받는 구조에서는 그 자리에 "goal 대기" 가 들어가고, goal 의 target_ref 로
#   shelves.yaml 의 approach 좌표를 읽어 NavigateTo 를 건 뒤 기존 트리로 들어간다.
#   주석처리된 PATROL 가지는 되살리지 않아도 된다 — 순찰 순서를 웹이 들기 때문이다.

# ── goal ──
# ★ 별도 메시지(TaskOrder.msg)로 빼 뒀다가 다시 붙였다. 소비자가 이 액션
#   하나뿐인데 중간 타입을 두면 goal.order.task_id 처럼 한 겹 깊어지기만 한다.
#   "큐 조회 응답에서도 쓴다" 는 이유를 댔었는데, 큐의 주인이 웹이라(WBS 0.3)
#   큐 조회는 REST(GET /api/robots/{id}/queue)다 — ROS 쪽에 그 소비자는 없다.

uint64 task_id                  # 표 5 task.task_id. feedback/result 가 이 값으로 돌아온다.
                                # 웹이 어느 행을 갱신할지 아는 유일한 끈이다.

string kind                     # SCAN | RECOVER   (표 5 의 task_kind ENUM 과 같은 값)
                                #   SCAN    — 선반에 가서 QR 판독 → pick → 이송 → place → 복귀
                                #   RECOVER — 스테이션에 가서 산출물 회수 (5단계 스케줄러가 만든다)

string target_ref               # yaml 의 id 다. FK 가 아니다(§10-2 ①).
                                #   kind=SCAN    → shelves.yaml 의 shelf_id   ("SHELF-A")
                                #   kind=RECOVER → stations.yaml 의 station_id ("PKG-01")
                                # task_manager 가 이 id 로 waypoint 와 층별 티칭 자세를 찾는다.
                                # 좌표를 직접 싣지 않는 이유: 자세의 주인은 파일이고(§8-5),
                                # 웹이 좌표를 실어 보내면 웹도 주인이 되어 둘이 갈라진다.

float32 resume_progress         # 0.0 = 처음부터. 웹 복구로 중단 지점부터 재개할 때만 > 0.
                                # ★ WBS 0.1 로 '층(pass)' 개념이 사라져 이 한 칸만 남았다.
                                # ★ 재개 시 run_id 를 이어갈지 새로 발행할지는 미정(§11 #2).
---
# ── result ──
uint8 NONE=0
uint8 NO_TARGET=1               # target_ref 를 yaml 에서 못 찾았다 (웹과 파일이 어긋남)
uint8 NOT_TAUGHT=2              # 그 선반에 티칭된 자세가 없다 (웹이 422 로 걸러야 했던 것)
uint8 SCAN_FAIL=3               # QR 을 끝내 못 읽었다 — 미션이 시작되지 않아 run_id 가 빈 값이다
uint8 PICK_FAIL=4               # 아래 셋은 하위 액션의 실패를 그대로 올린 것.
uint8 NAV_FAIL=5                #   구체적인 사유는 fail_detail 에 "{상수명}({코드})" 로 들어간다
uint8 PLACE_FAIL=6              #   (예: "PORT_OCCUPIED(3)") — DB 의 fail_detail 과 같은 문자열이다
uint8 CANCELED=7                # 화면의 SKIP / STOP. 실패가 아니라 의도된 중단이다.
uint8 NO_CARRIER=8              # 가 봤더니 비어 있었다. ★ 실패가 아니다 —
                                #   §8-4 의 "found=false 는 에러가 아니다" 와 같은 값이다.
                                #   웹은 이 작업을 DONE 으로 닫고 alert 를 띄우지 않는다.

bool   success                  # 캐리어 하나를 place 하고 선반까지 복귀했으면 true
bool   more_at_target           # 복귀한 선반에 아직 캐리어가 남아 있다.
                                # ★ 판단 시점은 return 이 끝난 뒤, 선반 앞이다 —
                                #   place 직후에는 스테이션에 있어 알 수 없다.
                                #   근거는 복귀 후 carrier_detected 가 다시 서는지.
                                # 웹이 이걸 보고 같은 선반에 후속 작업을 즉시 건다.
                                # 확신이 없으면 false — 그러면 사람이 다시 배정한다.
                                # (false 로 두는 쪽이 안전하다. true 로 잘못 말하면
                                #  로봇이 빈 선반을 왕복하며 NO_CARRIER 만 쌓는다)
string run_id                   # 발행됐으면 그 값. SCAN_FAIL·NO_CARRIER 면 빈 문자열이다.
uint8  fail_reason
string fail_detail              # DB 의 fail_detail 과 같은 문자열. 웹은 그대로 저장/표시한다.
---
# ── feedback ──
string stage                    # 소문자 — pick | nav | place | return. TraceEvent.stage 와 같은 값.
float32 progress                # 0.0 ~ 1.0. 중단되면 이 값이 task.resume_progress 로 저장된다.
string run_id                   # ScanLeaf 성공 직후 첫 feedback 부터 채워진다. 그 전에는 빈 문자열.
string carrier_id               # 판독된 QR 원문. 화면이 "무엇을 옮기는 중" 을 표시하는 데 쓴다.

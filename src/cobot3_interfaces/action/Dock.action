# task_manager  →  docking_server        액션 /docking/dock
#
# 기능: 마커 기준으로 베이스를 정밀 접안. 충전 패드(CHARGER)와
#       로드포트(LOAD_PORT)가 같은 동작이라 dock_kind 로 가른다.
#
# 부르는 쪽은 task_manager 만. docking_server 는 배터리를 세지 않는다 —
# 경과 시간 타이머와 soft/hard 임계는 task_manager 의 것이다. 충전 시작은
# 이 액션의 success 로 알고, 끝은 task_manager 가 시간으로 정한다.
# 나중에 실물 배터리가 붙으면 그 드라이버가 sensor_msgs/BatteryState 를 낸다.
#
# approach_pose 는 "이 마커가 여기쯤 있다" — task_manager 가 frames.yaml 로.
# 접안 노드는 "pkg_loader" 같은 이름을 모른다.
#
# ★ docking_server 가 declare_parameter 로 정의해야 하는 것
#   approach_dist_m     (double, 0.5 제안)   마커 정면 이 거리에서 접안 시퀀스 시작
#   yaw_tolerance_rad   (double, 0.02 제안)  넘으면 MISALIGN
#   timeout_s           (double, 30.0 제안)  넘으면 TIMEOUT
#   marker_dictionary   (string)             fiducial 종류. 예: ArUco DICT_4X4_50
#
# ★ task_manager 가 정의해야 하는 것 (이 액션과 짝 — 배터리 타이머)
#   soft_threshold_s    (double, 120.0)      넘으면 다음 RETURN 에서 Dock(CHARGER)
#   hard_threshold_s    (double, 0.0)        넘으면 즉시 중단 후 도킹. 0 = 미사용
#   charge_duration_s   (double, 제안)       이만큼 붙어 있으면 충전 완료 — 시뮬엔 배터리가 없다

# ── goal ──
uint8 CHARGER=0
uint8 LOAD_PORT=1

uint8 dock_kind
geometry_msgs/PoseStamped approach_pose # 접안 시퀀스 시작점. frame_id = map
int32 marker_id                         # 정렬 기준 fiducial ID
---
# ── result ──
uint8 NONE=0
uint8 NO_MARKER=1
uint8 MISALIGN=2                # 접근했지만 yaw 오차 초과
uint8 TIMEOUT=3
uint8 CANCELED=4

bool  success                   # CHARGER: 접점 성립 / LOAD_PORT: 정지 위치 성립
uint8 fail_reason
---
# ── feedback ──
uint8 SEARCH=0
uint8 APPROACH=1
uint8 BERTH=2
uint8 LATCH=3

uint8 phase

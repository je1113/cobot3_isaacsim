# cp .env.example .env
#
# 기본값은 "비워 둔다" 이다 — vite.config.js 의 프록시가 /api 와 /ws 를
# 백엔드(8000)로 넘기므로, 프론트는 언제나 자기 출처로만 요청한다.
# 배포 때도 백엔드가 dist 를 같이 서빙해 같은 출처라, 개발/배포에서
# 프론트 코드가 달라지지 않는다.
#
# 백엔드를 다른 호스트에 두면 그때만 채운다.

# 비워 두면 같은 출처(프록시 경유). 예: http://192.168.0.10:8000
VITE_API_BASE_URL=

# new WebSocket() 에 그대로 들어가므로 **전체 URL** 이어야 한다.
# 프록시를 쓰면 dev 서버 자신을 가리키면 된다.
VITE_WS_BASE_URL=ws://localhost:5173/ws

# 작업 배정 — POST. body 는 {robot_id, target_ref, kind}
VITE_TASK_START_PATH=/api/tasks

# 로그 조회 — GET. {items, next_cursor} 를 돌려준다
VITE_LOGS_PATH=/api/logs

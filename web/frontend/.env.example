# cp .env.example .env
#
# 기본값은 "비워 둔다" 이다 — vite.config.js 의 프록시가 /api 와 /ws 를
# 백엔드(8000)로 넘기므로, 프론트는 언제나 자기 출처로만 요청한다.
# 배포 때도 백엔드가 dist 를 같이 서빙해 같은 출처라, 개발/배포에서
# 프론트 코드가 달라지지 않는다.
#
# 백엔드를 다른 호스트에 두면 그때만 채운다.

# 비워 두면 같은 출처(프록시 경유). 예: http://192.168.0.10:8000
VITE_API_BASE_URL=

# 비워 두면 같은 출처의 /ws 로 간다(vite 프록시 경유). 그게 기본이고 권장값이다 —
# 포트가 밀리거나(5174) 배포판(백엔드가 dist 를 8000 에서 서빙)에서도 맞는 곳에 닿는다.
# src/api/websocket.js 가 바로 그 이유로 하드코딩된 5173 을 걷어냈으니 되살리지 말 것.
# 채울 때는 new WebSocket() 에 그대로 들어가므로 **전체 URL** 이어야 한다.
# 예: ws://192.168.0.10:8000/ws
VITE_WS_BASE_URL=

# 작업 배정 — POST. 화면이 보내는 body 는 로봇별 큐 **묶음**이다:
#   {"robots": [{"robot_id": "robot1", "queue": ["SHELF-A", "SHELF-C"]}, ...]}
# 이 모양을 받는 것은 /api/tasks/start 하나뿐이다. /api/tasks 는 작업 1건짜리
# ({robot_id, target_ref, kind}) 라 여기에 걸면 422 로 거절당한다.
VITE_TASK_START_PATH=/api/tasks/start

# 로그 조회 — GET. **최상위가 배열**이어야 한다 — 화면이 배열이 아니면 거절한다.
# {items, next_cursor} 를 주는 것은 /api/logs/page 라 여기에 쓸 수 없다.
VITE_LOGS_PATH=/api/logs

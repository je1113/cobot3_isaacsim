# cp .env.example .env  후 값을 고친다. uvicorn 이 자동으로 읽지 않으므로
# `set -a; . ./.env; set +a` 로 export 하거나 systemd EnvironmentFile 로 넣는다.

# ── DB ───────────────────────────────────────────────────────────────
COBOT3_DSN=postgresql://cobot3:cobot3@localhost:5432/cobot3
COBOT3_POOL_MIN=1
COBOT3_POOL_MAX=8

# ── 설정 yaml (설정의 주인은 파일이다 — docs/DB구성.md §10-1) ─────────
# 비워 두면 리포지토리 기준 상대경로를 쓴다.
#COBOT3_CONFIG_DIR=/home/rokey/cobot3_ws/src/cobot3_bringup/config
#COBOT3_TAUGHT_POSES=/home/rokey/cobot3_ws/isaacpjt/tools/out/taught_poses.yaml

# ── ROS 경계 ─────────────────────────────────────────────────────────
# 0 이면 NullBridge — 백엔드는 ROS 없이 완전히 뜬다.
# 읽기 API·설정 편집·큐 관리는 다 되고, '로봇에게 실제로 시키는' 것만 503.
COBOT3_ROS=1
COBOT3_ROBOTS=robot1,robot2
#COBOT3_POSE_TOPIC=/{robot}/amcl_pose
#COBOT3_STATE_TOPIC=/{robot}/orchestrator/state
COBOT3_POSE_HZ=8

# ── 회수 스케줄러 (WBS 5단계) ────────────────────────────────────────
COBOT3_PICKUP_TICK_SEC=5
COBOT3_PICKUP_MAX_RETRY=3
COBOT3_PICKUP_RETRY_BACKOFF_SEC=30

# ── HTTP ─────────────────────────────────────────────────────────────
COBOT3_CORS=http://localhost:5173
COBOT3_PAGE_LIMIT=100
COBOT3_PAGE_LIMIT_MAX=1000

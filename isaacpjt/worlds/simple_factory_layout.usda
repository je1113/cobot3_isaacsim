    def Xform "PanoramaBackdrop" (
        doc = "Visual-only cylindrical factory background. Radius 18m, height 5.6m, seven repeats. JPG wall texture. Existing floor, ceiling, conveyor design, physics, triggers and text unchanged."
    )
    {
        def Mesh "FactorySurround" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {

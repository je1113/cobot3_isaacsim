                    prepend uint inputs:execIn.connect = </World/Robots/nova_carter1/ros_joint_states/OnPlaybackTick.outputs:tick>
                    custom string inputs:nodeNamespace = "robot1"
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize
                    custom rel inputs:targetPrim = </World/Robots/nova_carter1/chassis_link> (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                    custom double inputs:timeStamp
                    prepend double inputs:timeStamp.connect = </World/Robots/nova_carter1/ros_joint_states/ReadSimTime.outputs:simulationTime>
                    custom string inputs:topicName = "joint_states"
                    token node:type = "isaacsim.ros2.bridge.ROS2PublishJointState"
                    int node:typeVersion = 1
                }
            }
        }


#usda 1.0
(
    defaultPrim = "FloorPreview"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FloorPreview"
{
    def Material "Material" (
        prepend references = @material.usda@
    )
    {
    }

    def Mesh "Surface" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </FloorPreview/Material>
        point3f[] points = [(-5, -5, 0), (5, -5, 0), (5, 5, 0), (-5, 5, 0)]
        texCoord2f[] primvars:st = [(0, 0), (20, 0), (20, 20), (0, 20)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }
}


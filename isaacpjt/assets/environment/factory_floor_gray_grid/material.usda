#usda 1.0
(
    defaultPrim = "FactoryFloorGrayGrid"
)

def Material "FactoryFloorGrayGrid"
{
    token outputs:surface.connect = </FactoryFloorGrayGrid/Surface.outputs:surface>

    def Shader "UV"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        string inputs:varname = "st"
        float2 outputs:result
    }

    def Shader "Texture"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @textures/gray_grid.png@
        token inputs:sourceColorSpace = "sRGB"
        float2 inputs:st.connect = </FactoryFloorGrayGrid/UV.outputs:result>
        token inputs:wrapS = "repeat"
        token inputs:wrapT = "repeat"
        float3 outputs:rgb
    }

    def Shader "Surface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </FactoryFloorGrayGrid/Texture.outputs:rgb>
        float inputs:metallic = 0
        float inputs:roughness = 0.82
        token outputs:surface
    }
}


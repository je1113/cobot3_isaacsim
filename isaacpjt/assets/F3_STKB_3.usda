    def Mesh "qr_label_ny" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        float3[] extent = [(-0.1573, -0.06845, 0.01996), (-0.1173, -0.06845, 0.05996)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </TrayStack/Looks/qr_mat>
        point3f[] points = [(-0.1573, -0.06845, 0.01996), (-0.1173, -0.06845, 0.01996), (-0.1173, -0.06845, 0.05996), (-0.1573, -0.06845, 0.05996)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "varying"
        )
    }

    def "Looks"
    {
        def Material "qr_mat"
        {
            token outputs:surface.connect = </TrayStack/Looks/qr_mat/surface.outputs:surface>

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./qr_F3_STKB_3.png@
                float2 inputs:st.connect = </TrayStack/Looks/qr_mat/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "surface"
            {

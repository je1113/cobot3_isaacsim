            color3f[] primvars:displayColor = [(0.22, 0.22, 0.24)]
            double size = 1
            float3 xformOp:scale = (0.3106, 0.002, 0.00362)
            double3 xformOp:translate = (0, 0.020649999999999995, 0.00381)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

